# Copy to .env (gitignored). Never commit real keys.
# nebius (required for the hackathon) or openrouter (free Nemotron, dev only, no card)
NIGHTSHIFT_PROVIDER=nebius
NEBIUS_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Hard spending cap per run, in USD.
NIGHTSHIFT_BUDGET_USD=2.00

# Set to 1 if scripts/check_models.py shows Token Factory honours `reasoning_budget`.
NIGHTSHIFT_SEND_REASONING_BUDGET=0

# Optional overrides if model IDs or endpoints change.
# NIGHTSHIFT_LIGHTNING_MODEL=nvidia/Nemotron-3_5-Lightning
# NIGHTSHIFT_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIGHTSHIFT_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NIGHTSHIFT_ULTRA_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
